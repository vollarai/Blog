<div class="admin-header">
  <% if @post %>
    <h1 class="admin-title">PDFs for "<%= @post.title %>"</h1>
  <% else %>
    <h1 class="admin-title">All PDFs</h1>
  <% end %>
</div>

<div class="admin-list" id="pdfs">
  <% @pdfs.each do |pdf| %>
    <div class="admin-card">
      <div>
        <div class="admin-card-title"><%= pdf.file.attached? ? pdf.file.filename : "#{pdf.filename}.pdf" %></div>
        <div class="admin-card-meta">
          <% unless @post %>
            Post: <%= pdf.post.title %> &middot;
          <% end %>
          Status: <%= pdf.status %>
        </div>
      </div>
      <div class="admin-card-actions">
        <% if pdf.processed? && pdf.file.attached? %>
          <%= link_to "Download", blog_pdf_path(pdf), class: "btn-secondary" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>