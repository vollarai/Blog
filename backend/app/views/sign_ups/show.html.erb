<div class="auth-wrapper">
  <div class="auth-card">
    <h1 class="auth-title">Create an account</h1>
    <p class="auth-subtitle">Join the blog and start writing.</p>

    <%= form_with model: @user, url: sign_up_path do |form| %>
      <% if form.object.errors.any? %>
        <div class="auth-flash-error"><%= form.object.errors.full_messages.first %></div>
      <% end %>

      <div class="form-field">
        <%= form.label :first_name, class: "form-label" %>
        <%= form.text_field :first_name, required: true, autofocus: true, autocomplete: "given-name", class: "form-input" %>
      </div>

      <div class="form-field">
        <%= form.label :last_name, class: "form-label" %>
        <%= form.text_field :last_name, required: true, autocomplete: "family-name", class: "form-input" %>
      </div>

      <div class="form-field">
        <%= form.label :email_address, class: "form-label" %>
        <%= form.email_field :email_address, required: true, autocomplete: "email", class: "form-input" %>
      </div>

      <div class="form-field">
        <%= form.label :password, class: "form-label" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", class: "form-input" %>
      </div>

      <div class="form-field">
        <%= form.label :password_confirmation, class: "form-label" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "form-input" %>
      </div>

      <div class="form-actions">
        <%= form.submit "Sign up", class: "btn-primary", style: "width:100%" %>
      </div>
    <% end %>

    <p class="auth-footer">Already have an account? <%= link_to "Sign in", new_session_path %></p>
  </div>
</div>
