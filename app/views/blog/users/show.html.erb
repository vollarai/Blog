<%= link_to "← All users", blog_users_path, class: "admin-back-link" %>

<div class="admin-detail-card">
  <div class="admin-detail-row">
    <span class="admin-detail-label">Name</span>
    <span class="admin-detail-value"><%= @user.full_name %></span>
  </div>
  <div class="admin-detail-row">
    <span class="admin-detail-label">Email</span>
    <span class="admin-detail-value"><%= @user.email_address %></span>
  </div>
</div>

<div class="form-actions">
  <%= link_to "Edit", edit_blog_user_path(@user), class: "btn-secondary" %>
  <%= button_to "Delete account", blog_user_path(@user), method: :delete, data: { turbo_confirm: "Are you sure? This cannot be undone." }, class: "btn-danger" %>
</div>
