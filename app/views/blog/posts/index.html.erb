<div class="admin-header">
  <h1 class="admin-title"><%= t ".title" %></h1>
  <%= link_to "New post", new_blog_post_path, class: "btn-primary" %>
</div>

<div class="admin-list" id="posts">
  <% @posts.each do |post| %>
    <div class="admin-card">
      <div>
        <div class="admin-card-title"><%= post.title.presence || post.name %></div>
        <div class="admin-card-meta">by <%= post.name %></div>
      </div>
      <div class="admin-card-actions">
        <%= link_to "View", blog_post_path(post), class: "btn-secondary" %>
      </div>
    </div>
  <% end %>
</div>
