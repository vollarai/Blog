<%= link_to "← All posts", blog_posts_path, class: "admin-back-link" %>

<div class="admin-detail-card">
  <div class="admin-detail-row">
    <span class="admin-detail-label">Author</span>
    <span class="admin-detail-value"><%= @post.name %></span>
  </div>
  <div class="admin-detail-row">
    <span class="admin-detail-label">Title</span>
    <span class="admin-detail-value"><%= @post.title %></span>
  </div>
  <div class="admin-detail-row">
    <span class="admin-detail-label">Content</span>
    <span class="admin-detail-value"><%= @post.content %></span>
  </div>
</div>

<div class="form-actions">
  <%= link_to "Edit", edit_blog_post_path(@post), class: "btn-secondary" %>
  <%= button_to "Delete", blog_post_path(@post),
        method: :delete,
        data: { turbo_confirm: "Are you sure?" },
        class: "btn-danger",
        form: { style: "display:inline" } %>
</div>
