<div class="auth-wrapper">
  <div class="auth-card">
    <h1 class="auth-title">Forgot your password?</h1>
    <p class="auth-subtitle">Enter your email and we'll send reset instructions.</p>

    <% if flash[:alert] %>
      <div class="auth-flash-error"><%= flash[:alert] %></div>
    <% end %>

    <%= form_with url: passwords_path do |form| %>
      <div class="form-field">
        <%= form.label :email_address, "Email", class: "form-label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
              value: params[:email_address], class: "form-input" %>
      </div>

      <div class="form-actions">
        <%= form.submit "Send reset instructions", class: "btn-primary", style: "width:100%" %>
      </div>
    <% end %>

    <p class="auth-footer"><%= link_to "Back to sign in", new_session_path %></p>
  </div>
</div>
