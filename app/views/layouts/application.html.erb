<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Blog" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Blog">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body style="background: #0f0f0f; color: white;">
    <header class="site-header">
      <div class="header-inner">
        <div class="header-brand">
          <div class="brand-icon">B</div>
          <span class="brand-name">Blog</span>
        </div>
        <nav class="navbar">
          <%= link_to "Home", root_path, class: current_page?(root_path) ? "nav-active" : "" %>
          <% if authenticated? %>
            <%= link_to "Settings", settings_profile_path, class: current_page?(settings_profile_path) ? "nav-active" : "" %>
            <%= button_to "Log out", session_path, method: :delete %>
          <% else %>
            <%= link_to "Sign Up", sign_up_path, class: current_page?(sign_up_path) ? "btn-signup nav-active" : "btn-signup" %>
            <%= link_to "Login", new_session_path, class: current_page?(new_session_path) ? "nav-active" : "" %>
          <% end %>
        </nav>
      </div>
    </header>

    <main>
      <%= content_for?(:content) ? yield(:content) :yield %>
    </main>
  </body>
</html>
