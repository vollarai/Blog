<h2 class="settings-section-title">Profile</h2>

<div class="settings-card">
  <%= form_with model: Current.user, url: settings_profile_path do |form| %>
    <% if form.object.errors.any? %>
      <div class="form-error"><%= form.object.errors.full_messages.first %></div>
    <% end %>

    <div class="form-field">
      <%= form.label :first_name, class: "form-label" %>
      <%= form.text_field :first_name, required: true, autocomplete: "given-name", class: "form-input" %>
    </div>

    <div class="form-field">
      <%= form.label :last_name, class: "form-label" %>
      <%= form.text_field :last_name, required: true, autocomplete: "family-name", class: "form-input" %>
    </div>

    <div class="form-actions">
      <%= form.submit "Update profile", class: "btn-primary" %>
    </div>
  <% end %>
</div>
