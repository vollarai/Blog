<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }

      html {
        background: #0f0f0f;
        height: 100%;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        background: #0f0f0f;
        color: #d4d4d8;
        font-size: 14px;
        line-height: 1.7;
        padding: 20mm 40mm;
        min-height: 100%;
      }

      .pdf-article { padding: 8px 0 40px; }

      .article-meta {
        display: flex;
        gap: 10px;
        font-size: 13px;
        color: #a1a1aa;
        margin-bottom: 16px;
      }

      .post-author { color: #6366f1; }

      .article-title {
        font-size: 36px;
        font-weight: 800;
        line-height: 1.15;
        color: #818cf8;
        margin-bottom: 28px;
      }

      .article-image { margin-bottom: 28px; }
      .article-image img { width: 100%; border-radius: 10px; display: block; }

      .article-content {
        color: #d4d4d8;
        font-size: 15px;
        line-height: 1.8;
      }
      .article-content p { margin-bottom: 18px; }

      .pdf-comments {
        margin-top: 40px;
        border-top: 1px solid #333;
        padding-top: 32px;
      }

      .comments-heading {
        font-size: 18px;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 20px;
      }

      .comment {
        padding: 16px 20px;
        border-radius: 10px;
        border: 1px solid #222;
        background-color: #141414;
        margin-bottom: 14px;
        page-break-inside: avoid;
      }

      .comment-author {
        font-size: 13px;
        font-weight: 600;
        color: #d4d4d8;
        margin-bottom: 6px;
      }

      .comment-body { color: #a1a1aa; }

      .comments-empty { color: #52525b; }
    </style>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
