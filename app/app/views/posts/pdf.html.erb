<div class="pdf-article">
  <div class="article-meta">
    <span class="post-author"><%= @post.name %></span>
    <span>·</span>
    <time><%= @post.created_at.strftime("%B %-d, %Y") %></time>
  </div>

  <h1 class="article-title"><%= @post.title %></h1>

  <% if @post.image&.image&.present? %>
    <div class="article-image">
      <% path = @post.image.image.path.to_s %>
      <% if %w[.webp .avif].include?(File.extname(path).downcase) %>
        <% img = MiniMagick::Image.open(path); img.format("jpeg") %>
        <img src="data:image/jpeg;base64,<%= Base64.strict_encode64(img.to_blob) %>" alt="<%= @post.title %>">
      <% else %>
        <img src="file://<%= path %>" alt="<%= @post.title %>">
      <% end %>
    </div>
  <% end %>

  <div class="article-content">
    <%= simple_format @post.content %>
  </div>
</div>

<section class="pdf-comments">
  <h2 class="comments-heading">Comments</h2>

  <% if @post.comments.any? %>
    <% @post.comments.each do |comment| %>
      <div class="comment">
        <div class="comment-author"><%= comment.user.full_name %></div>
        <p class="comment-body"><%= comment.body %></p>
      </div>
    <% end %>
  <% else %>
    <p class="comments-empty">No comments yet.</p>
  <% end %>
</section>
