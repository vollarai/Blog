<div class="auth-wrapper">
  <div class="auth-card">
    <h1 class="auth-title">Welcome back</h1>
    <p class="auth-subtitle">Sign in to your account.</p>

    <% if flash[:alert] %>
      <div class="auth-flash-error"><%= flash[:alert] %></div>
    <% end %>
    <% if flash[:notice] %>
      <div class="auth-flash-notice"><%= flash[:notice] %></div>
    <% end %>

    <%= form_with url: session_path do |form| %>
      <div class="form-field">
        <%= form.label :email_address, "Email", class: "form-label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
              value: params[:email_address], class: "form-input" %>
      </div>

      <div class="form-field">
        <%= form.label :password, "Password", class: "form-label" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password",
              maxlength: 72, class: "form-input" %>
      </div>

      <div class="form-actions">
        <%= form.submit "Sign in", class: "btn-primary", style: "width:100%" %>
      </div>
    <% end %>

    <hr class="auth-divider">

    <p class="auth-footer">
      <%= link_to "Forgot your password?", new_password_path %> ·
      <%= link_to "Sign up", sign_up_path %>
    </p>
  </div>
</div>
